msgstr "Temporary facility lighting interruption detected."

#: resources/cases/test_case_01.tres:140
msgid "LIGHT: NORMAL → OFF"
msgstr "LIGHT: NORMAL → OFF"

#: resources/cases/test_case_01.tres:145
msgid "TEST VENTILATION INSTABILITY"
msgstr "TEST VENTILATION INSTABILITY"

#: resources/cases/test_case_01.tres:146

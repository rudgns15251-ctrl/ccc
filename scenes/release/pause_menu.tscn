[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/release/pause_menu.gd" id="1_pause"]
[ext_resource type="PackedScene" path="res://scenes/release/settings_panel.tscn" id="2_settings"]

[node name="PauseMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_pause")

[node name="Backdrop" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"ModalBackdropPanel"

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Menu" type="PanelContainer" parent="Center"]
unique_name_in_owner = true
custom_minimum_size = Vector2(680, 0)
layout_mode = 2
theme_type_variation = &"ChassisPanel"

[node name="Margin" type="MarginContainer" parent="Center/Menu"]
layout_mode = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 32

[node name="Stack" type="VBoxContainer" parent="Center/Menu/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/Menu/Margin/Stack"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "일시정지"

[node name="Hint" type="Label" parent="Center/Menu/Margin/Stack"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "진행 저장은 대상 정보 또는 격리 화면의 진행 저장 버튼에서 합니다."
autowrap_mode = 3

[node name="Buttons" type="VBoxContainer" parent="Center/Menu/Margin/Stack"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="ResumeButton" type="Button" parent="Center/Menu/Margin/Stack/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 68)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "계속하기"

[node name="SettingsButton" type="Button" parent="Center/Menu/Margin/Stack/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 68)
layout_mode = 2
text = "설정"

[node name="TitleButton" type="Button" parent="Center/Menu/Margin/Stack/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 68)
layout_mode = 2
text = "타이틀로"

[node name="QuitButton" type="Button" parent="Center/Menu/Margin/Stack/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 68)
layout_mode = 2
text = "게임 종료"

[node name="Confirm" type="VBoxContainer" parent="Center/Menu/Margin/Stack"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 16

[node name="Question" type="Label" parent="Center/Menu/Margin/Stack/Confirm"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"WarningLabel"
text = "저장하지 않은 진행은 사라집니다."
autowrap_mode = 3

[node name="Row" type="HBoxContainer" parent="Center/Menu/Margin/Stack/Confirm"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="CancelButton" type="Button" parent="Center/Menu/Margin/Stack/Confirm/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
size_flags_horizontal = 3
text = "취소"

[node name="ConfirmButton" type="Button" parent="Center/Menu/Margin/Stack/Confirm/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TransmitButton"
text = "확인"

[node name="SettingsPanel" parent="Center" instance=ExtResource("2_settings")]
unique_name_in_owner = true
visible = false
layout_mode = 2

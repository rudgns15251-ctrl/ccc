[node name="HeadingSlot" type="VBoxContainer" parent="QuestionLayout/Selection/Stack"]
layout_mode = 2

[node name="ProgressSlot" type="VBoxContainer" parent="QuestionLayout/Selection/Stack"]
layout_mode = 2


[gd_scene format=3]

[node name="BroadcastConsole" type="VBoxContainer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="Identification" type="PanelContainer" parent="."]
layout_mode = 2
theme_type_variation = "EmergencyPanel"

[node name="Row" type="HBoxContainer" parent="Identification"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="TitleSlot" type="HBoxContainer" parent="Identification/Row"]
layout_mode = 2

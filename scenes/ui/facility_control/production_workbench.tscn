[gd_scene format=3]

[node name="ProductionWorkbench" type="VBoxContainer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Environment" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Body" type="HBoxContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="Left" type="PanelContainer" parent="Body"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.0
theme_type_variation = "ChassisPanel"

[node name="Stack" type="VBoxContainer" parent="Body/Left"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Right" type="PanelContainer" parent="Body"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.4
theme_type_variation = "InstrumentPanel"

[node name="Stack" type="VBoxContainer" parent="Body/Right"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Review" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Controls" type="PanelContainer" parent="."]
layout_mode = 2
theme_type_variation = "ChassisPanel"

[node name="Actions" type="VBoxContainer" parent="Controls"]
layout_mode = 2

[gd_resource type="Resource" script_class="CampaignData" load_steps=16 format=3]

[ext_resource type="Script" path="res://scripts/data/campaign_data.gd" id="1_campaign"]
[ext_resource type="Script" path="res://scripts/data/campaign_entry_data.gd" id="2_entry"]
[ext_resource type="Resource" path="res://resources/cases/test_case_01.tres" id="3_case01"]
[ext_resource type="Resource" path="res://resources/cases/test_case_02.tres" id="4_case02"]
[ext_resource type="Resource" path="res://resources/cases/test_case_03.tres" id="5_case03"]

[ext_resource type="Resource" path="res://resources/incidents/temp_mandatory_incident_01.tres" id="6_temp_mandatory01"]
[ext_resource type="Script" path="res://scripts/data/scripted_interrupt_occurrence_data.gd" id="7_interrupt"]
[ext_resource type="Resource" path="res://resources/incidents/temp_midcase_incident_01.tres" id="8_temp_midcase01"]

[ext_resource type="Resource" path="res://resources/cases/temp_m5_a_visual_case.tres" id="m2_case"]

[sub_resource type="Resource" id="Resource_entry_case01"]
script = ExtResource("2_entry")
entry_id = "TEST_ENTRY_CASE_01"
entry_kind = 0
case_data = ExtResource("3_case01")

[sub_resource type="Resource" id="Resource_entry_case02"]
script = ExtResource("2_entry")
entry_id = "TEST_ENTRY_CASE_02"
entry_kind = 0
case_data = ExtResource("4_case02")

; [TEMP STORY CONTENT] CASE02 -> sequential Mandatory 01 -> CASE03.
[sub_resource type="Resource" id="Resource_entry_temp_mandatory01"]
script = ExtResource("2_entry")
entry_id = "TEMP_ENTRY_MANDATORY_01"
entry_kind = 1
scripted_incident_data = ExtResource("6_temp_mandatory01")

[sub_resource type="Resource" id="Resource_entry_case03"]
script = ExtResource("2_entry")
entry_id = "TEST_ENTRY_CASE_03"
entry_kind = 0
case_data = ExtResource("5_case03")

; [TEMP STORY CONTENT] Side occurrence; never advances the entry sequence.
[sub_resource type="Resource" id="Resource_interrupt_temp_midcase01"]
script = ExtResource("7_interrupt")
interrupt_id = "TEMP_INTERRUPT_MIDCASE_01"
target_entry_id = "TEST_ENTRY_CASE_03"
scripted_incident_data = ExtResource("8_temp_midcase01")
checkpoint_kind = 0
stage_id = "EXPERIMENT"
action_id = ""

[sub_resource type="Resource" id="Entry_M2"]
script = ExtResource("2_entry")
entry_id = "TEMP_M4_ENTRY_01"
entry_kind = 0
case_data = ExtResource("m2_case")

[resource]
script = ExtResource("1_campaign")
campaign_id = "TEMP_M5_A_VISUAL_PLAYTEST"
display_name = "[TEMP / NON-CANON] M4 playtest / existing test continuation"
entries = Array[ExtResource("2_entry")]([SubResource("Entry_M2"), SubResource("Resource_entry_case01"), SubResource("Resource_entry_case02"), SubResource("Resource_entry_temp_mandatory01"), SubResource("Resource_entry_case03")])
scripted_interrupts = Array[ExtResource("7_interrupt")]([SubResource("Resource_interrupt_temp_midcase01")])

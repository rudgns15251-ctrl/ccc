body_text = "Select a route and contact precautions using the Profile and CCTV observations. Review the complete broadcast before transmission. Selection alone does not transmit an order."

[sub_resource type="Resource" id="Answer_GROUND"]
script = ExtResource("option")
option_id = "TEMP_M4_ANSWER_GROUND"
display_text = "Use the grounded maintenance bypass."
instruction_text = "Evacuate through the maintenance bypass with the grounded conductive floor and low airflow. Avoid the shorter synthetic-lined supply passage and its ventilation outlet."

[sub_resource type="Resource" id="Answer_SHORT"]
script = ExtResource("option")
option_id = "TEMP_M4_ANSWER_SHORT"
display_text = "Use the shorter synthetic-lined passage."
instruction_text = "Evacuate through the shorter supply passage with synthetic floor covering, toward its ventilation outlet."

[sub_resource type="Resource" id="Answer_AVOID"]
script = ExtResource("option")
option_id = "TEMP_M4_ANSWER_AVOID"
display_text = "Avoid handling or wetting membrane pieces."
instruction_text = "Keep clear of loose membrane and dry synthetic coverings. Do not handle the pieces or apply water to them. Close the access door after passing and keep other staff out of the exposed corridor."

[sub_resource type="Resource" id="Answer_WET"]
script = ExtResource("option")
option_id = "TEMP_M4_ANSWER_WET"
display_text = "Wet and move obstructing membrane pieces by hand."
instruction_text = "Wet obstructing membrane pieces with water, then move them aside by hand so staff can pass. Close the access door after passing."

[sub_resource type="Resource" id="Question_ROUTE"]
script = ExtResource("question")
question_id = "ROUTE"
prompt_text = "Which evacuation route should staff use?"
options = Array[ExtResource("option")]([SubResource("Answer_GROUND"), SubResource("Answer_SHORT")])

[sub_resource type="Resource" id="Question_CONTACT"]
script = ExtResource("question")
question_id = "CONTACT"
prompt_text = "How should staff respond to membrane pieces along the route?"
options = Array[ExtResource("option")]([SubResource("Answer_AVOID"), SubResource("Answer_WET")])


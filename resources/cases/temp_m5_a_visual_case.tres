source_id = "TEMP_M4_RESULT_3"
title = "[TEMP / NON-CANON] Evacuation observation 4"
body_text = "Wetting and handling produced more detached pieces near the outlet. One staff death and three staff injuries were confirmed in the exposed passage. These authored TEMP counts do not establish total facility staffing."

[sub_resource type="Resource" id="Research_ANSWER_GROUND"]
script = ExtResource("research")
entry_id = "TEMP_M4_RESEARCH_ANSWER_GROUND"
source_kind = 6
source_id = "TEMP_M4_ANSWER_GROUND"
title = "Use the grounded maintenance bypass."
body_text = "Evacuate through the maintenance bypass with the grounded conductive floor and low airflow. Avoid the shorter synthetic-lined supply passage and its ventilation outlet."

[sub_resource type="Resource" id="Research_ANSWER_SHORT"]
script = ExtResource("research")
entry_id = "TEMP_M4_RESEARCH_ANSWER_SHORT"
source_kind = 6
source_id = "TEMP_M4_ANSWER_SHORT"
title = "Use the shorter synthetic-lined passage."
body_text = "Evacuate through the shorter supply passage with synthetic floor covering, toward its ventilation outlet."

[sub_resource type="Resource" id="Research_ANSWER_AVOID"]
script = ExtResource("research")
entry_id = "TEMP_M4_RESEARCH_ANSWER_AVOID"
source_kind = 6
source_id = "TEMP_M4_ANSWER_AVOID"
title = "Avoid handling or wetting membrane pieces."
body_text = "Keep clear of loose membrane and dry synthetic coverings. Do not handle the pieces or apply water to them. Close the access door after passing and keep other staff out of the exposed corridor."

[sub_resource type="Resource" id="Research_ANSWER_WET"]
script = ExtResource("research")
entry_id = "TEMP_M4_RESEARCH_ANSWER_WET"
source_kind = 6
source_id = "TEMP_M4_ANSWER_WET"
title = "Wet and move obstructing membrane pieces by hand."
body_text = "Wet obstructing membrane pieces with water, then move them aside by hand so staff can pass. Close the access door after passing."

[sub_resource type="Resource" id="Broadcast"]
script = ExtResource("broadcast")
broadcast_id = "TEMP_M4_BROADCAST_EVAC"
display_name = "[TEMP / NON-CANON] Membrane escape / staff evacuation"
prompt_text = "Select a route and contact precautions using the Profile and CCTV observations. Review the complete broadcast before transmission. Selection alone does not transmit an order."
warning_text = "[TEMP / NON-CANON] Emergency warning. Detached membrane is present in the access corridor. All staff in the exposed corridor must evacuate using the following instructions. No civilian presence has been reported."
questions = Array[ExtResource("question")]([SubResource("Question_ROUTE"),SubResource("Question_CONTACT")])
outcomes = Array[ExtResource("combination")]([SubResource("Combination_0"), SubResource("Combination_1"), SubResource("Combination_2"), SubResource("Combination_3")])

[resource]
script = ExtResource("case")
case_id = "TEMP_M4_CASE_01"
display_name = "[TEMP / NON-CANON] Lamellar Sac"
profile_data = SubResource("Profile")
cctv_data = SubResource("CCTV")
experiment_limit = 2

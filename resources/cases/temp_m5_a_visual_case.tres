containment_outcomes = Array[ExtResource("outcome")]([SubResource("Outcome_WARM"), SubResource("Outcome_CONDUCTIVE"), SubResource("Outcome_BATH")])
incidents = Array[ExtResource("incident")]([SubResource("Incident")])
emergency_broadcasts = Array[ExtResource("broadcast")]([SubResource("Broadcast")])
incident_results = Array[ExtResource("result")]([SubResource("Result_0"), SubResource("Result_1"), SubResource("Result_2"), SubResource("Result_3")])
research_entries = Array[ExtResource("research")]([SubResource("Research_PROFILE"), SubResource("Research_CCTV"), SubResource("Research_EXP_GROUND"), SubResource("Research_EXP_HUMID"), SubResource("Research_EXP_WATER"), SubResource("Research_ROOM_WARM"), SubResource("Research_ROOM_CONDUCTIVE"), SubResource("Research_ROOM_BATH"), SubResource("Research_INCIDENT"), SubResource("Research_BROADCAST"), SubResource("Research_RESULT_0"), SubResource("Research_RESULT_1"), SubResource("Research_RESULT_2"), SubResource("Research_RESULT_3"), SubResource("Research_ANSWER_GROUND"), SubResource("Research_ANSWER_SHORT"), SubResource("Research_ANSWER_AVOID"), SubResource("Research_ANSWER_WET")])

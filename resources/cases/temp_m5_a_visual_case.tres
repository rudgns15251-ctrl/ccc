description = "Staff used the grounded bypass without handling or wetting pieces. No staff deaths or injuries were found in the inspected evacuation group. This is a local observation, not a facility-wide headcount."
staff_deaths = 0
staff_injuries = 0
facility_damage = "No additional facility damage was found in the inspected bypass."
additional_observation = "Recapture and complete sealing are unconfirmed. The original containment failure remains recorded. These consequences are authored TEMP observations, not a casualty formula."

[sub_resource type="Resource" id="Combination_0"]
script = ExtResource("combination")
option_id = "TEMP_M4_COMBINATION_0"
display_text = "[TEMP / NON-CANON] Emergency warning. Detached membrane is present in the access corridor. All staff in the exposed corridor must evacuate using the following instructions. No civilian presence has been reported.\n\nEvacuate through the maintenance bypass with the grounded conductive floor and low airflow. Avoid the shorter synthetic-lined supply passage and its ventilation outlet.\n\nKeep clear of loose membrane and dry synthetic coverings. Do not handle the pieces or apply water to them. Close the access door after passing and keep other staff out of the exposed corridor."
result_id = "TEMP_M4_RESULT_0"
answers = Dictionary[String, String]({"ROUTE": "TEMP_M4_ANSWER_GROUND", "CONTACT": "TEMP_M4_ANSWER_AVOID"})


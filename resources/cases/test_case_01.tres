[sub_resource type="Resource" id="Resource_profile"]
script = ExtResource("2_profile")
profile_id = "TEST_PROFILE_01"
subject_name = "TEST SUBJECT"
classification = "TEST CLASSIFICATION"
basic_description = "TEST: metal-support pump cycles preceded strikes; no talk link."

[sub_resource type="Resource" id="Resource_cctv"]
script = ExtResource("3_cctv")
camera_id = "TEST_CAM_01"
observation_text = "TEST: strikes cluster at pump starts; vent cycling prompts turn-backs. Lamp sweeps alter travel, not strike timing. Wall tracing continues."

[sub_resource type="Resource" id="Resource_experiment_01"]
script = ExtResource("4_experiment")
experiment_id = "TEST_EXP_01"
display_name = "TEST EXPERIMENT 01"
description = "TEST support comparison: apply equal small impulses through metal and padded supports; keep airborne pump sound and airflow unchanged."
result_text = "Strike bursts follow metal-support impulses more often than padded-support impulses. Airborne pump sound is unchanged; slow wall tracing persists on both supports. This test does not compare airflow cycles."

[sub_resource type="Resource" id="Resource_experiment_02"]
script = ExtResource("4_experiment")
experiment_id = "TEST_EXP_02"
display_name = "TEST EXPERIMENT 02"
description = "TEST airflow comparison: compare continuous low airflow with repeated start/stop pulses; keep support and pump sound unchanged."
result_text = "Start/stop airflow prompts repeated turn-backs toward the outlet; continuous low airflow produces fewer turn-backs. Wall tracing persists in both trials. This test does not compare support isolation."

[sub_resource type="Resource" id="Resource_experiment_03"]
script = ExtResource("4_experiment")
experiment_id = "TEST_EXP_03"
display_name = "TEST EXPERIMENT 03"
description = "TEST sound comparison: replay pump sound through a speaker while support impulses and airflow changes are absent."
result_text = "The subject briefly orients toward the speaker, but the replay does not reproduce the pump-start strike bursts. Wall tracing continues. Airborne sound alone does not explain the earlier timing link."


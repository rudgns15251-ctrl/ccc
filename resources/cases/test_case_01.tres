[sub_resource type="Resource" id="Resource_incident_01"]
script = ExtResource("8_incident")
incident_id = "TEST_INCIDENT_01"
display_name = "TEST SERVICE-STRUCTURE INCIDENT"
description = "TEST observation: strikes cluster at service-panel mounts after pump starts. Vibration travels along the service structure as emergency lighting drops out. Airflow is currently steady; wall tracing continues between strikes."
broadcast_id = "TEST_BROADCAST_01"
environmental_disturbance = SubResource("Resource_disturbance_power")

[sub_resource type="Resource" id="Resource_incident_03"]
script = ExtResource("8_incident")
incident_id = "TEST_INCIDENT_03"
display_name = "TEST VENTILATION INCIDENT"
description = "TEST observation: vent stop/start pulses are followed by sharp turn-backs toward the outlet. Wall tracing is repeatedly interrupted by crossings of the ventilation path. Airflow remains unstable after each service restart."
broadcast_id = "TEST_BROADCAST_03"
environmental_disturbance = SubResource("Resource_disturbance_ventilation")

[sub_resource type="Resource" id="Resource_option_01_A"]
script = ExtResource("9_option")
option_id = "TEST_OPTION_01_A"
display_text = "Mechanically isolate the service mounts and keep airflow steady. Prioritizes transmitted impulses, but leaves movement near the access seam to be observed."
result_id = "TEST_INCIDENT_RESULT_01_A"

[sub_resource type="Resource" id="Resource_option_01_B"]
script = ExtResource("9_option")
option_id = "TEST_OPTION_01_B"
display_text = "Quiet airborne machinery noise while retaining rigid service connections and steady airflow. Preserves the connection, but transmitted impulses remain."
result_id = "TEST_INCIDENT_RESULT_01_B"

[sub_resource type="Resource" id="Resource_option_01_C"]
script = ExtResource("9_option")
option_id = "TEST_OPTION_01_C"
display_text = "Cycle ventilation to redirect movement away from service panels while keeping the supports connected. Repeated airflow transitions may draw attention to the outlet."
result_id = "TEST_INCIDENT_RESULT_01_C"

[sub_resource type="Resource" id="Resource_broadcast_01"]
script = ExtResource("10_broadcast")
broadcast_id = "TEST_BROADCAST_01"
display_name = "TEST RESPONSE: SERVICE VIBRATION"
prompt_text = "Strikes track pump starts; the earlier sound-only trial did not reproduce them. Outlet turn-backs track airflow changes. Choose which cue to alter while the service panels vibrate. These temporary responses do not establish long-term containment."
options = Array[ExtResource("9_option")]([SubResource("Resource_option_01_A"), SubResource("Resource_option_01_B"), SubResource("Resource_option_01_C")])

[sub_resource type="Resource" id="Resource_option_03_A"]
script = ExtResource("9_option")
option_id = "TEST_OPTION_03_A"
display_text = "Hold continuous low airflow with the present lighting and supports. Removes repeated airflow transitions, while other sources of stimulation remain untested."
result_id = "TEST_INCIDENT_RESULT_03_A"

[sub_resource type="Resource" id="Resource_option_03_B"]
script = ExtResource("9_option")
option_id = "TEST_OPTION_03_B"
display_text = "Reduce task lighting while retaining vent cycling and the present supports. Aims to reduce crossing movements, but does not remove airflow transitions."
result_id = "TEST_INCIDENT_RESULT_03_B"

[sub_resource type="Resource" id="Resource_option_03_C"]
script = ExtResource("9_option")
option_id = "TEST_OPTION_03_C"
display_text = "Add damping at the service mounts while retaining vent cycling. Prioritizes structural transmission, but leaves the repeating airflow cue in place."
result_id = "TEST_INCIDENT_RESULT_03_C"

[sub_resource type="Resource" id="Resource_broadcast_03"]
script = ExtResource("10_broadcast")
broadcast_id = "TEST_BROADCAST_03"
display_name = "TEST RESPONSE: AIRFLOW CYCLING"
prompt_text = "Outlet turn-backs coincide with airflow transitions. Earlier lamp sweeps changed travel rather than strike timing; mechanical isolation addresses transmitted impacts. Choose a temporary response while wall tracing is interrupted by vent pulses."
options = Array[ExtResource("9_option")]([SubResource("Resource_option_03_A"), SubResource("Resource_option_03_B"), SubResource("Resource_option_03_C")])

[sub_resource type="Resource" id="Resource_incident_result_01_A"]
script = ExtResource("11_incident_result")
result_id = "TEST_INCIDENT_RESULT_01_A"
display_name = "TEST MECHANICAL ISOLATION OBSERVATION"
description = "Service mounts were isolated and airflow held steady. Panel strikes became less frequent; wall tracing and brief approaches to the access seam continued. Transmitted impacts were reduced, but movement near the seam remains to be observed."

[sub_resource type="Resource" id="Resource_incident_result_01_B"]
script = ExtResource("11_incident_result")
result_id = "TEST_INCIDENT_RESULT_01_B"
display_name = "TEST NOISE REDUCTION OBSERVATION"
description = "Airborne machinery noise was reduced while rigid connections remained. Brief orientations toward the speaker stopped, but strikes still clustered at pump starts. Steady airflow avoided added outlet turn-backs; structural transmission remains unresolved."

[sub_resource type="Resource" id="Resource_incident_result_01_C"]
script = ExtResource("11_incident_result")
result_id = "TEST_INCIDENT_RESULT_01_C"
display_name = "TEST VENT CYCLING OBSERVATION"
description = "Vent cycling initially drew movement away from the panel. Further restarts produced repeated outlet turn-backs; panel strikes continued after pump starts. The initial redirection did not remove transmitted impulses and added a repeating airflow cue."

[sub_resource type="Resource" id="Resource_incident_result_03_A"]
script = ExtResource("11_incident_result")
result_id = "TEST_INCIDENT_RESULT_03_A"
display_name = "TEST STEADY AIRFLOW OBSERVATION"
description = "Continuous low airflow replaced the stop/start pulses. Outlet turn-backs became less frequent and wall tracing resumed over longer stretches. Approaches to service panels continued; the airflow cue was reduced without testing all structural stimuli."

[sub_resource type="Resource" id="Resource_incident_result_03_B"]
script = ExtResource("11_incident_result")
result_id = "TEST_INCIDENT_RESULT_03_B"
display_name = "TEST LIGHTING REDUCTION OBSERVATION"
description = "Reduced lighting produced fewer crossings and longer pauses between movements. Each vent restart still prompted outlet turn-backs. The change altered travel but left the repeated airflow cue and interrupted wall tracing unresolved."

[sub_resource type="Resource" id="Resource_incident_result_03_C"]
script = ExtResource("11_incident_result")
result_id = "TEST_INCIDENT_RESULT_03_C"
display_name = "TEST SERVICE DAMPING OBSERVATION"
description = "Added damping reduced pulse-linked vibration at service panels. Vent restarts still prompted outlet turn-backs and repeatedly interrupted wall tracing. Structural vibration was reduced, while the cycling airflow cue remained."


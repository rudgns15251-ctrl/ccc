available_experiments = Array[ExtResource("4_experiment")]([SubResource("Resource_experiment_01"), SubResource("Resource_experiment_02"), SubResource("Resource_experiment_03")])
available_containment_rooms = Array[ExtResource("5_containment")]([SubResource("Resource_room_01"), SubResource("Resource_room_02"), SubResource("Resource_room_03")])
containment_outcomes = Array[ExtResource("7_outcome")]([SubResource("Resource_outcome_01"), SubResource("Resource_outcome_02"), SubResource("Resource_outcome_03")])
incidents = Array[ExtResource("8_incident")]([SubResource("Resource_incident_01"), SubResource("Resource_incident_03")])
emergency_broadcasts = Array[ExtResource("10_broadcast")]([SubResource("Resource_broadcast_01"), SubResource("Resource_broadcast_03")])
incident_results = Array[ExtResource("11_incident_result")]([SubResource("Resource_incident_result_01_A"), SubResource("Resource_incident_result_01_B"), SubResource("Resource_incident_result_01_C"), SubResource("Resource_incident_result_03_A"), SubResource("Resource_incident_result_03_B"), SubResource("Resource_incident_result_03_C")])
research_entries = Array[ExtResource("12_research")]([SubResource("Resource_research_profile"), SubResource("Resource_research_cctv"), SubResource("Resource_research_experiment"), SubResource("Resource_research_room"), SubResource("Resource_research_incident"), SubResource("Resource_research_broadcast"), SubResource("Resource_research_option"), SubResource("Resource_research_result"), SubResource("Resource_research_experiment_02"), SubResource("Resource_research_experiment_03"), SubResource("Resource_research_room_01"), SubResource("Resource_research_room_03"), SubResource("Resource_research_incident_03"), SubResource("Resource_research_broadcast_03"), SubResource("Resource_research_option_01_A"), SubResource("Resource_research_option_01_C"), SubResource("Resource_research_option_03_A"), SubResource("Resource_research_option_03_B"), SubResource("Resource_research_option_03_C"), SubResource("Resource_research_result_01_A"), SubResource("Resource_research_result_01_C"), SubResource("Resource_research_result_03_A"), SubResource("Resource_research_result_03_B"), SubResource("Resource_research_result_03_C")])

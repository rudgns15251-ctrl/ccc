body_text = "시각·음향 복합 자극에서 두부 반응 우선순위가 분리되며 사지 협응성이 급격히 저하되었다."

[sub_resource type="Resource" id="Resource_2iece"]
script = ExtResource("18_gesos")
entry_id = "RL_T04_EXP_LOWSTIM"
source_kind = 2
source_id = "EXP_T04_LOWSTIM"
title = "RL_T04_EXP_LOWSTIM"
body_text = "조도와 비필수 음향을 낮추자 두부 회전과 상지 탐색이 감소했다. 벽면 흡음 재질은 바꾸지 않았으므로 흡음 성능을 검증한 결과는 아니다."

[sub_resource type="Resource" id="Resource_lg5wx"]
script = ExtResource("18_gesos")
entry_id = "RL_T04_EXP_AIR"
source_kind = 2
source_id = "EXP_T04_AIR"
title = "RL_T04_EXP_AIR"
body_text = "기류 변화에 대한 반응은 확인되었으나 주요 불안정화 요인으로 보기는 어렵다."

[sub_resource type="Resource" id="Resource_q18qn"]
script = ExtResource("18_gesos")
entry_id = "RL_T04_CONTAINMENT_SUCCESS"
source_kind = 11
source_id = "ROOM_T04_LOWSTIM"
title = "RL_T04_CONTAINMENT_SUCCESS"
body_text = "낮고 일정한 조도, 높은 내부 흡음과 외부 소음 차단을 갖춘 환경에서 T04는 장시간 안정 상태를 유지했다."

[sub_resource type="Resource" id="Resource_nljt0"]
script = ExtResource("18_gesos")
entry_id = "RL_T04_CONTAINMENT_FAIL_01"
source_kind = 11
source_id = "ROOM_T04_STANDARD"
title = "RL_T04_CONTAINMENT_FAIL_01"
body_text = "부적절한 환경에서 T04의 상지 탐색 행동이 점진적으로 증가했다."

[sub_resource type="Resource" id="Resource_60o7j"]
script = ExtResource("18_gesos")
entry_id = "RL_T04_CONTAINMENT_FAIL_02"
source_kind = 11
source_id = "ROOM_T04_METALLIC"
title = "RL_T04_CONTAINMENT_FAIL_02"
body_text = "불안정화 초기, 대상은 출입문과 벽면 상단 구조를 반복 접촉했다."

[sub_resource type="Resource" id="Resource_idg3t"]
script = ExtResource("18_gesos")
entry_id = "RL_T04_CONTAINMENT_FAIL_03"
source_kind = 11
source_id = "ROOM_T04_METALLIC"
title = "RL_T04_CONTAINMENT_FAIL_03"
body_text = "T04의 격리 실패는 파괴보다 구조 간섭 누적에 의해 진행될 가능성이 높다."

[sub_resource type="Resource" id="Resource_vwdhb"]
script = ExtResource("18_gesos")
entry_id = "RL_T04_INCIDENT_01"
source_kind = 4
source_id = "INC_T04_01"
title = "RL_T04_INCIDENT_01"
body_text = "T04는 복도 환경에서 반향 자극이 증가할수록 탐색 범위를 넓혔다."

[sub_resource type="Resource" id="Resource_wtkoq"]
script = ExtResource("18_gesos")
entry_id = "RL_T04_INCIDENT_02"
source_kind = 4
source_id = "INC_T04_01"
title = "RL_T04_INCIDENT_02"
body_text = "탈출 후 대상의 주요 위험은 예측하기 어려운 상지 접촉 범위에 있다."

[sub_resource type="Resource" id="Resource_g767q"]
script = ExtResource("18_gesos")
entry_id = "RL_T04_INCIDENT_03"
source_kind = 5
source_id = "BROADCAST_T04_EVACUATION"
title = "RL_T04_INCIDENT_03"
body_text = "강한 지시, 손전등 흔들기, 금속성 충돌음은 현장 위험도를 증가시킨다."

[sub_resource type="Resource" id="Resource_bsh57"]
script = ExtResource("18_gesos")
entry_id = "RL_T04_INCIDENT_04"
source_kind = 6
source_id = "BQ_T04_FACILITY_2"
title = "RL_T04_INCIDENT_04"
body_text = "저자극 차폐 공간으로의 후퇴가 직접 대면보다 생존 가능성을 높인다."

[sub_resource type="Resource" id="Resource_7aqse"]
script = ExtResource("18_gesos")
entry_id = "ARCHIVE_T04_01"
source_id = "PROFILE_T04"
title = "초동 확보 보고서"
body_text = "[TEMP / DRAFT / NON-CANON]
현장 확보 인원 3명은 대상을 단일 개체로 분류하지 못했다.
두 개의 두부가 서로 독립적으로 주변을 경계했고, 상지가 서로 다른 방향으로 움직였기 때문이다.
근접 고정 이후 대상은 단일 체간을 공유하는 것으로 확인되었다."

[sub_resource type="Resource" id="Resource_lfhen"]
script = ExtResource("18_gesos")
entry_id = "ARCHIVE_T04_02"
source_id = "PROFILE_T04"
title = "초기 오판 소견서"
body_text = "[초기 가설·정정 대상 / TEMP]
대상은 강광(强光)에 대해 불쾌 반응을 보이는 것으로 추정된다.
A두의 안면 긴장도 증가와 치열 노출 확대로 미루어, 강광을 억제 수단으로 활용할 가능성이 있다."

[sub_resource type="Resource" id="Resource_u3yg4"]
script = ExtResource("18_gesos")
entry_id = "ARCHIVE_T04_03"
source_kind = 2
source_id = "EXP_T04_COMBINED"
title = "후속 정정 기록"
body_text = "[TEMP / DRAFT / NON-CANON]
강광이 단독으로 위험도를 증가시킨다는 이전 결론은 재현성이 낮았다.
반대로, 반향성 음향과 이동광이 결합된 조건에서 대상의 비협응성 상지 운동이 반복 확인되었다.
문제는 광량 자체보다 복합 자극 총량일 가능성이 높다."


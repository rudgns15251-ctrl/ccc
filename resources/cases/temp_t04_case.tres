[sub_resource type="Resource" id="Resource_8sodi"]
script = ExtResource("1_yfaav")
room_id = "ROOM_T04_STANDARD"
display_name = "ROOM A · 표준 격리실"
description = "일반 조도 / 보통 외부 소음 차단 / 보통 내부 반향 / 표준 기류. 일상 점검 소음과 조명 변화가 남는다. 임시 비교값: 20°C, 상대습도 45%. 온습도는 핵심 판단 기준이 아니다."

[sub_resource type="Resource" id="Resource_4nvgt"]
script = ExtResource("1_yfaav")
room_id = "ROOM_T04_METALLIC"
display_name = "ROOM B · 저조도 금속 격리실"
description = "저조도 / 보통 외부 소음 차단 / 낮은 내부 흡음 / 높은 금속성 반향 / 표준 기류. 조용해진 뒤에도 실내 금속 표면에서 잔향이 오래 남을 수 있다. 임시 비교값: 20°C, 상대습도 45%."

[sub_resource type="Resource" id="Resource_xrk5l"]
script = ExtResource("1_yfaav")
room_id = "ROOM_T04_LOWSTIM"
display_name = "ROOM C · 저자극 격리실"
description = "낮고 일정한 조도 / 높은 내부 흡음 / 강화된 외부 소음 차단 / 표준 기류. 외부 유입음과 실내 반사를 구분해 줄이는 구성이다. 임시 비교값: 20°C, 상대습도 45%."

[sub_resource type="Resource" id="Resource_nmc8b"]
script = ExtResource("2_earpo")
experiment_id = "EXP_T04_ECHO"
display_name = "음향 반향 비교"
description = "[임시 실험 / 원격 절차]
실행 전 안내: 같은 최대 음량의 단발 금속 충격음과 녹음된 잔향 포함 신호를 원격 비교한다. 벽면 재질은 교체하지 않는다. 각 신호를 중단하고 기본 상태로 복구한다."
result_text = "[실행 기록 / TEMP]
단발 충격음에 웃는 두부가 회전하고 상부 팔 1~2개가 반응했다. 잔향 포함 신호에서는 두부 회전과 두 상부 팔의 벽면 접촉이 더 오래 지속됐다. 신호 중단 뒤 탐색이 서서히 감소했다. 일회 반응이 곧 격리 실패를 의미하지 않는다."

[sub_resource type="Resource" id="Resource_4li76"]
script = ExtResource("2_earpo")
experiment_id = "EXP_T04_LIGHT"
display_name = "이동광 추적"
description = "[임시 실험 / 원격 절차]
실행 전 안내: 한쪽 벽에 제한된 이동광을 조사하고 종료한다. 음향·기류·실내 재질은 바꾸지 않는다."
result_text = "[실행 기록 / TEMP]
큰 눈의 두부가 이동광을 즉시 추적했다. 목 회전과 일부 상지 움직임은 증가했으나 전신 협응 붕괴는 관찰되지 않았다. 광원 중단 뒤 시선 추적이 감소하고 자세가 안정됐다."

[sub_resource type="Resource" id="Resource_nlxh3"]
script = ExtResource("2_earpo")
experiment_id = "EXP_T04_COMBINED"
display_name = "복합 감각 부하"
description = "[임시 실험 / 원격 절차]
실행 전 안내: 한쪽 벽의 이동광과 반대편 스피커의 잔향 음향을 짧게 중첩한 뒤 원격으로 종료한다. 시험 자극은 장기 노출을 재현하지 않는다."
result_text = "[실행 기록 / TEMP]
두 두부가 서로 다른 방향을 향했다. 네 팔의 움직임이 증가하고 일부 팔이 교차했으며 몸통의 균형이 흔들렸다. 자극 중단 후 움직임이 감소하고 균형이 회복됐다. 이 실험만으로 실제 탈출이나 추가 페널티가 발생하지 않는다."

[sub_resource type="Resource" id="Resource_oaltn"]
script = ExtResource("2_earpo")
experiment_id = "EXP_T04_LOWSTIM"
display_name = "저자극 환경 반응"
description = "[임시 실험 / 원격 절차]
실행 전 안내: 기본 격리실의 조도를 낮추고 비필수 스피커·시험 장치를 정지한다. 필수 환기는 유지하며 벽면 흡음 재질은 변경하지 않는다."
result_text = "[실행 기록 / TEMP]
조도와 음향 자극 감소 후 두부 회전과 상지 탐색이 줄었다. 장시간 직립 정지와 팔끝의 미세 움직임이 지속됐다. 현재 공간의 자극 감소에 대한 결과이며 새 격리실의 흡음 성능 자체를 검증한 것은 아니다."

[sub_resource type="Resource" id="Resource_hqbw2"]
script = ExtResource("2_earpo")
experiment_id = "EXP_T04_AIR"
display_name = "기류 변화"
description = "[임시 실험 / 원격 절차]
실행 전 안내: 기본 환기를 유지하다 송풍량을 제한적으로 높인 뒤 원상 복구한다. 광원·음향 조건은 유지한다."
result_text = "[실행 기록 / TEMP]
팔끝과 두부 주변 돌기가 미세하게 움직이고 일부 상지가 송풍 방향을 향했다. 전신 불안정화나 급격한 탐색 증가는 확인되지 않았다. 돌기의 감각 기능은 가설이며 이번 관찰로 확정하지 않는다."

[sub_resource type="Resource" id="Resource_suwgk"]
script = ExtResource("4_3o80y")
camera_id = "CAM_T04_TEXT_OBSERVATION"
observation_text = "[TEMP / DRAFT / NON-CANON] T04 관찰 기록. CCTV 장면과 열화상은 미제공이다. 아래는 사용자 설계에 근거해 작성한 텍스트 관찰이며 Master 전신 이미지를 감시 영상으로 표시하지 않는다.

00:00 — 낮고 일정한 조도에서 장시간 직립 정지한다. 팔끝의 미세 탐색은 계속된다. 정지가 비활성 상태를 뜻하지 않는다.

00:40 — 일상 점검의 짧은 금속음에 웃는 두부와 상부 팔이 먼저 반응한다. 소리가 멎자 반응은 감소한다. 동일한 점검음이 금속 통로에 오래 울릴 때에는 벽과 문틀 접촉이 더 오래 지속된다.

01:20 — 이동 점검등을 큰 눈의 두부가 따라간다. 단독 광원 변화에서는 일부 상지만 움직이고 전신 균형은 유지된다.

02:00 — 점검등 이동과 반향음이 겹치자 두부의 지향 방향이 갈리고 네 팔이 교차한다. 두 자극을 멈추자 자세가 회복된다. 이 짧은 관찰에서 격리 이탈은 확인되지 않는다.

02:40 — 소음 유입을 차단해도 남아 있는 실내 잔향에 구조물 탐색이 계속된다. 외부 유입 감소(방음)와 실내 반사 감소(흡음)는 다른 조건이다. 조용해진 뒤에는 탐색이 감소하지만 완전 정지로 보이는 동안에도 말단 움직임은 지속된다.

장기 격리 비교에는 일정한 조명, 외부 소음 유입과 내부 반향을 각각 확인해야 한다. 기류 변화가 주된 불안정화 원인이라는 근거는 이 관찰에 없다."


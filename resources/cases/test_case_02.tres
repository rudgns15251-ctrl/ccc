observation_text = "After the lighting interruption, subject movement became less frequent. Repeated wall contact continued."

[sub_resource type="Resource" id="Resource_reaction_ventilation"]
script = ExtResource("7_reaction")
reaction_id = "TEST_CASE02_REACTION_VENTILATION"
disturbance_id = "TEST_DIST_VENTILATION_INSTABILITY"
display_name = "Unplanned Observation: TEST AIRFLOW INTERRUPTION"
observation_text = "During intermittent airflow, repeated wall contact continued. Subject movement remained intermittent."

[sub_resource type="Resource" id="Resource_research_reaction_power"]
script = ExtResource("6_research")
entry_id = "TEST_CASE02_RESEARCH_REACTION_POWER_OFF"
source_kind = 8
source_id = "TEST_CASE02_REACTION_POWER_OFF"
title = "Unplanned Observation: test lighting interruption"
body_text = "With LIGHT changed from NORMAL to OFF, subject movement became less frequent while repeated wall contact continued."

[sub_resource type="Resource" id="Resource_cctv_condition_power"]
script = ExtResource("8_cctv_condition")
observation_id = "TEST_CASE02_POWER_CCTV_OBS"
cctv_id = "TEST_CASE02_CAM_01"
disturbance_id = "TEST_DIST_POWER_FAILURE"
display_name = "TEST CCTV OBSERVATION - LIGHTING INTERRUPTION"
observation_text = "TEST observation: After the lighting interruption, movement across the room became less frequent. Repeated wall contact continued without a clear change."

[sub_resource type="Resource" id="Resource_research_cctv_condition_power"]
script = ExtResource("6_research")
entry_id = "TEST_CASE02_RESEARCH_POWER_CCTV_OBS"
source_kind = 9
source_id = "TEST_CASE02_POWER_CCTV_OBS"
title = "Test CCTV follow-up: lighting interruption"
body_text = "During CCTV recheck after LIGHT changed from NORMAL to OFF, movement across the room was less frequent. Repeated wall contact continued without a clear change. This is a temporary observation record."

[sub_resource type="Resource" id="Resource_experiment_condition_power"]
script = ExtResource("9_experiment_condition")
observation_id = "TEST_CASE02_POWER_EXP01_OBS"
experiment_id = "TEST_CASE02_EXP_01"
disturbance_id = "TEST_DIST_POWER_FAILURE"
display_name = "TEST EXPERIMENT OBSERVATION - LIGHTING INTERRUPTION"
observation_text = "TEST supporting observation: During this experiment with lighting interrupted, the first movement after the stimulus began later than in the temporary normal-light reference. Repeated wall contact continued."

[sub_resource type="Resource" id="Resource_research_experiment_condition_power"]
script = ExtResource("6_research")
entry_id = "TEST_CASE02_RESEARCH_POWER_EXP01_OBS"
source_kind = 10
source_id = "TEST_CASE02_POWER_EXP01_OBS"
title = "Condition Observation: test experiment 01 under lighting interruption"
body_text = "TEST experiment record: With lighting interrupted at execution, the first movement following the stimulus began later than in the temporary normal-light reference; repeated wall contact continued. This observation alone does not establish the cause of the delay."

[resource]
script = ExtResource("1_case")
case_id = "TEST_CASE_02"
display_name = "TEST CASE 02"
experiment_limit = 2
profile_data = SubResource("Resource_profile")
cctv_data = SubResource("Resource_cctv")
available_experiments = Array[ExtResource("4_experiment")]([SubResource("Resource_experiment_01"), SubResource("Resource_experiment_02")])
available_containment_rooms = Array[ExtResource("5_containment")]([SubResource("Resource_room_01"), SubResource("Resource_room_02")])
research_entries = Array[ExtResource("6_research")]([SubResource("Resource_research_profile"), SubResource("Resource_research_experiment_01"), SubResource("Resource_research_room_01"), SubResource("Resource_research_reaction_power"), SubResource("Resource_research_cctv_condition_power"), SubResource("Resource_research_experiment_condition_power")])
disturbance_reactions = Array[ExtResource("7_reaction")]([SubResource("Resource_reaction_power"), SubResource("Resource_reaction_ventilation")])
cctv_condition_observations = Array[ExtResource("8_cctv_condition")]([SubResource("Resource_cctv_condition_power")])
experiment_condition_observations = Array[ExtResource("9_experiment_condition")]([SubResource("Resource_experiment_condition_power")])

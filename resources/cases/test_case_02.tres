source_kind = 10
source_id = "TEST_CASE02_POWER_EXP01_OBS"
title = "Condition Observation: test experiment 01 under lighting interruption"
body_text = "Without lighting, an air pulse still caused a nozzle-directed pivot with a later first step than the lit reference. Wall tracing resumed; onset delay alone did not explain wall searching."

[resource]
script = ExtResource("1_case")

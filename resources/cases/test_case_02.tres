[ext_resource type="Script" path="res://scripts/data/cctv_condition_observation_data.gd" id="8_cctv_condition"]
[ext_resource type="Script" path="res://scripts/data/experiment_condition_observation_data.gd" id="9_experiment_condition"]

[sub_resource type="Resource" id="Resource_profile"]

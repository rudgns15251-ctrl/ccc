[sub_resource type="Resource" id="Resource_profile"]
script = ExtResource("2_profile")
profile_id = "TEST_CASE02_PROFILE_01"
subject_name = "TEST SUBJECT CASE 02"
classification = "TEST CLASSIFICATION CASE 02"
basic_description = "TEST: wall-contact loss precedes searching; no damage recorded."

[sub_resource type="Resource" id="Resource_cctv"]
script = ExtResource("3_cctv")
camera_id = "TEST_CASE02_CAM_01"
observation_text = "TEST: vent cycles prompt turns to the outlet. A paw follows shallow wall ribs; on smooth patches it sweeps sideways. No new damage appears."

[sub_resource type="Resource" id="Resource_experiment_01"]
script = ExtResource("4_experiment")
experiment_id = "TEST_CASE02_EXP_01"
display_name = "TEST CASE 02 EXPERIMENT 01"
description = "TEST cue comparison: deliver short air pulses from a fixed nozzle, then replay fan sound alone. Keep wall surface and lighting unchanged."
result_text = "Air pulses repeatedly prompt a pivot toward the nozzle and then wall tracing resumes. Fan sound alone produces no consistent pivot. This test does not establish whether wall texture affects searching."

[sub_resource type="Resource" id="Resource_experiment_02"]
script = ExtResource("4_experiment")
experiment_id = "TEST_CASE02_EXP_02"
display_name = "TEST CASE 02 EXPERIMENT 02"
description = "TEST surface comparison: present adjacent shallow-ribbed and smooth wall panels under the same airflow and lighting; record paw tracks and contact pressure."
result_text = "Paw tracks follow the shallow ribs; on the smooth panel, sideways searches recur. Contact pressure does not increase on either panel. This test does not compare continuous and start/stop airflow."

[sub_resource type="Resource" id="Resource_room_01"]
script = ExtResource("5_containment")
room_id = "TEST_CASE02_ROOM_01"
display_name = "TEST CASE 02 ROOM 01"
description = "TEST configuration: continuous low airflow; shallow-ribbed wall panels without sharp edges; ordinary task lighting."

[sub_resource type="Resource" id="Resource_room_02"]
script = ExtResource("5_containment")
room_id = "TEST_CASE02_ROOM_02"
display_name = "TEST CASE 02 ROOM 02"
description = "TEST configuration: start/stop airflow; smooth wall panels without purchase points; reduced task lighting."

[sub_resource type="Resource" id="Resource_research_profile"]
script = ExtResource("6_research")
entry_id = "TEST_CASE02_RESEARCH_PROFILE_01"
source_kind = 0
source_id = "TEST_CASE02_PROFILE_01"
title = "Case 02 intake: wall contact and searching"
body_text = "Intake associates loss of wall contact with searching; no damage is documented."

[sub_resource type="Resource" id="Resource_research_experiment_01"]
script = ExtResource("6_research")
entry_id = "TEST_CASE02_RESEARCH_EXP_01"
source_kind = 2
source_id = "TEST_CASE02_EXP_01"
title = "Case 02 experiment 01: airflow and sound cues"
body_text = "Air pulses caused nozzle-directed pivots followed by wall tracing; fan sound alone produced no consistent pivot. Wall texture's effect on searching remains untested here."

[sub_resource type="Resource" id="Resource_research_room_01"]
script = ExtResource("6_research")
entry_id = "TEST_CASE02_RESEARCH_ROOM_01"
source_kind = 3
source_id = "TEST_CASE02_ROOM_01"
title = "Test Case 02 room 01 submission"
body_text = "Room 01 submission: continuous low airflow; shallow-ribbed wall panels without sharp edges; ordinary task lighting. Its containment result remains pending."

[sub_resource type="Resource" id="Resource_reaction_power"]
script = ExtResource("7_reaction")
reaction_id = "TEST_CASE02_REACTION_POWER_OFF"
disturbance_id = "TEST_DIST_POWER_FAILURE"
display_name = "Unplanned Observation: TEST LIGHTING INTERRUPTION"
observation_text = "When the lights cut out, the subject pauses its crossing for eight seconds with one paw still on a ribbed panel. It then resumes wall tracing; the pause does not break wall contact."

[sub_resource type="Resource" id="Resource_reaction_ventilation"]
script = ExtResource("7_reaction")
reaction_id = "TEST_CASE02_REACTION_VENTILATION"
disturbance_id = "TEST_DIST_VENTILATION_INSTABILITY"
display_name = "Unplanned Observation: TEST AIRFLOW INTERRUPTION"
observation_text = "At the first unexpected vent stop, the subject turns toward the outlet and makes two short sideways searches. Wall contact continues and pressure marks do not deepen. This is a single transition observation."

[sub_resource type="Resource" id="Resource_research_reaction_power"]
script = ExtResource("6_research")
entry_id = "TEST_CASE02_RESEARCH_REACTION_POWER_OFF"
source_kind = 8
source_id = "TEST_CASE02_REACTION_POWER_OFF"
title = "Unplanned Observation: test lighting interruption"
body_text = "Without lighting: an eight-second crossing pause with a paw on a ribbed panel, then renewed wall tracing. Contact was maintained through the pause."

[sub_resource type="Resource" id="Resource_cctv_condition_power"]
script = ExtResource("8_cctv_condition")
observation_id = "TEST_CASE02_POWER_CCTV_OBS"
cctv_id = "TEST_CASE02_CAM_01"
disturbance_id = "TEST_DIST_POWER_FAILURE"
display_name = "TEST CCTV OBSERVATION - LIGHTING INTERRUPTION"
observation_text = "TEST follow-up over two minutes without lighting: fewer room crossings occur, but tracing still follows the shallow ribs. Vent start/stop still prompts turns toward the outlet. The initial pause is not a lasting loss of these responses."

[sub_resource type="Resource" id="Resource_research_cctv_condition_power"]
script = ExtResource("6_research")
entry_id = "TEST_CASE02_RESEARCH_POWER_CCTV_OBS"
source_kind = 9
source_id = "TEST_CASE02_POWER_CCTV_OBS"
title = "Test CCTV follow-up: lighting interruption"
body_text = "Without lighting over two minutes: fewer crossings, yet rib tracing and turns at vent transitions continued. The initial pause did not persist as a loss of those responses."

[sub_resource type="Resource" id="Resource_experiment_condition_power"]
script = ExtResource("9_experiment_condition")
observation_id = "TEST_CASE02_POWER_EXP01_OBS"
experiment_id = "TEST_CASE02_EXP_01"
disturbance_id = "TEST_DIST_POWER_FAILURE"
display_name = "TEST EXPERIMENT OBSERVATION - LIGHTING INTERRUPTION"
observation_text = "TEST supporting result without lighting: the same air pulse still prompts a pivot toward the nozzle, but the first step starts later than in the lit trial. Wall tracing resumes. The delay alone does not explain wall searching."

[sub_resource type="Resource" id="Resource_research_experiment_condition_power"]
script = ExtResource("6_research")

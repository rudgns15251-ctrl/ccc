[sub_resource type="Resource" id="Resource_grc1r"]
script = ExtResource("2_ms2hu")
experiment_id = "EXP_SC01_LIGHT_LOW"
display_name = "조도 감소 시험"
description = "[임시 실험 / 원격 절차]
실행 전 안내: 실내 조명을 저조도로 낮추고 60초 관찰한다. 소리·기류·진동은 바꾸지 않는다."
result_text = "[실행 기록 / TEMP]
안구 고정과 경부 긴장이 약간 줄었고 호흡이 완만해졌다. 눈의 노출이 조금 줄었으나 머리 압박 행동은 그대로 유지되었다."
result_texture = ExtResource("3_l03l5")

[sub_resource type="Resource" id="Resource_ym501"]
script = ExtResource("2_ms2hu")
experiment_id = "EXP_SC01_AIRFLOW_HIGH"
display_name = "공조 기류 증가 시험"
description = "[임시 실험 / 원격 절차]
실행 전 안내: 환기량과 공조 풍량을 올리고 30초 관찰한다. 조명과 소리는 바꾸지 않는다."
result_text = "[실행 기록 / TEMP]
즉시 불안정 반응이 나타났다. 머리 압박이 강해지고 시선이 상부로 고정되더니 급격한 보행이 이어졌다. 환기구 방향 확인과 벽 접촉이 늘었다."
result_texture = ExtResource("4_8w8yl")

[sub_resource type="Resource" id="Resource_n6jma"]
script = ExtResource("2_ms2hu")
experiment_id = "EXP_SC01_VIBRO_LOW"
display_name = "저주파 진동 시험"
description = "[임시 실험 / 원격 절차]
실행 전 안내: 바닥을 통한 약한 반복 진동을 20초 가한다. 소리 크기는 올리지 않는다."
result_text = "[실행 기록 / TEMP]
소리 크기와 무관하게 반응이 급증했다. 웅크림이 무너지고 비정상적인 도약 준비 자세가 나타났다. 발과 손의 접지점이 불안정해지고 머리를 강하게 눌렀다."
result_texture = ExtResource("5_dmxv2")

[sub_resource type="Resource" id="Resource_4mnnk"]
script = ExtResource("2_ms2hu")
experiment_id = "EXP_SC01_SOUNDPROOF"
display_name = "반향 감소 시험"
description = "[임시 실험 / 원격 절차]
실행 전 안내: 실내 반향을 억제하고 외부 소음을 차단한 채 90초 관찰한다."
result_text = "[실행 기록 / TEMP]
단독으로는 완전히 안정되지 않았으나 이동 빈도가 줄었다. 벽 접촉 뒤 장시간 정지했고 근본적인 압박 행동은 남았다."
result_texture = ExtResource("6_r1tbs")

[sub_resource type="Resource" id="Resource_rxykr"]
script = ExtResource("2_ms2hu")
experiment_id = "EXP_SC01_TEMP_LOW"
display_name = "저온 시험"
description = "[임시 실험 / 원격 절차]
실행 전 안내: 실내 온도를 약 12°C까지 낮추고 90초 관찰한다. 조명·기류·소리는 바꾸지 않는다."
result_text = "[실행 기록 / TEMP]
근육 긴장과 경직이 늘어났다. 머리 압박은 유지되었고 움직임은 줄었지만 안정이 아니라 굳은 상태였다. 손발 끝이 가늘게 떨렸다."
result_texture = ExtResource("7_d6g0t")

[sub_resource type="Resource" id="Resource_nxm3x"]
script = ExtResource("10_sgqg0")
camera_id = "CAM_SC01_TEXT_OBSERVATION"
observation_text = "[TEMP / DRAFT / NON-CANON] SC-01 관찰 기록. 화면의 장면은 사용자 제공 외형 이미지를 표준 격리실에 합성한 임시 이미지이며 실제 감시 영상이 아니다. 열화상은 미제공이다. 판단 근거는 아래 텍스트 관찰이다.

00:00 — 방 한가운데 웅크린 채 양손으로 머리를 누른다. 상체를 약간 숙이고 눈은 뜬 채 고정, 미세한 흔들림만 있다.
02:40 — 방 내부 팬이 작동한 직후 손 압박이 강해지고 경부가 길게 늘어난다. 상부 환기구 방향을 바라보며 눈이 더 크게 드러나고 입이 벌어진다. 불규칙한 체위 변경이 두세 번 있다.
04:20 — 실내 가습 장치가 작동 중이다. 습도가 올라가도 머리 압박과 환기구 주시에는 변화가 없다.
06:10 — 조용한 상태가 이어지자 천천히 벽면으로 이동해 측두부와 어깨를 벽에 밀착한다. 흔들림을 억제하듯 기대어 정지한다.
09:30 — 조도가 올라가자 눈을 감지 못하고 시선이 고정된다. 움직임은 줄었지만 안정이 아니라 경직으로 보인다."
camera_label = "CAM SC01-01 · 표준 격리실 상부"
feed_texture = ExtResource("9_6bjkm")


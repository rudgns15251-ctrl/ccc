[sub_resource type="Resource" id="Resource_ysdj8"]
script = ExtResource("19_8pevo")
result_id = "RESULT_SC01_0"
display_name = "[임시·초안] SC-01 사고 후속 보고"
description = "[TEMP / DRAFT / NON-CANON]
사고 원인: 부적절한 격리 환경에서의 지속적 기류·구조진동 노출과 상부 환기 설비 접촉.

대응 검토: 고속 이동, 광자극, 금속 접촉, 기류 증가 또는 경보 유지 지시가 개체의 반응을 키웠다. 접근 구역 확대와 피해 가능성에 대한 추가 조사가 필요하다.

송출한 지시:
큰 소리로 구조를 요청하며 빠르게 계단을 내려가라.
인접 공조기를 최대 출력으로 가동하라.

조치 상태: 보고 완료 / 후속 점검 대기. 원래 격리 실패는 방송 대응과 별개의 이력으로 유지한다."
facility_damage = "배기 덕트 보호망과 상부 설비 손상 확인. 추가 손상 범위는 조사 중. 공조 구역 폐쇄 검토."
additional_observation = "고속 이동, 광자극, 금속 접촉, 기류 증가 또는 경보 유지 지시가 개체의 반응을 키웠다. 접근 구역 확대와 피해 가능성에 대한 추가 조사가 필요하다. 사망·부상 인원은 UNKNOWN이며 0명으로 단정하지 않는다."


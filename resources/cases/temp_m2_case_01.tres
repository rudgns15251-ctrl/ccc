[sub_resource type="Resource" id="Profile"]
script = ExtResource("profile")
profile_id = "TEMP_M2_PROFILE"
subject_name = "[TEMP / NON-CANON] Lamellar Sac"
classification = "Temporary research specimen / mechanism under investigation"
basic_description = "A folded, silver-grey membrane sac about 70 cm long. It has a dark longitudinal seam and many fine, dry fringes, but no visible eyes or mouth. The fringes rise before the body unrolls. It was recovered as a compact fold in a metal collection tray.\n\nThe following observations and interpretations belong only to this temporary playtest. They do not identify an official Case or establish facility history."
past_observations = "OBSERVATION A — The recovery tray was connected to a grounding lead; the room meter read 61% relative humidity. Both conditions were present together, so the recovery does not identify which mattered. Moving the fold onto an acrylic packing mat preceded fringe lifting. The humidity during transfer was not recorded.\n\nOBSERVATION B — A warm metal tool pressed the fringes down while touching the seam. After contact ended they rose again. Tool temperature, conductivity and the contact itself were not separated.\n\nOBSERVATION C — Direct droplets loosened transparent membrane pieces. A subsequent air pulse carried pieces beyond the tray. The same report records no comparable shedding during humid-air exposure without droplets. No conclusion about immersion safety was established."
researcher_notes = "WORKING INTERPRETATION — The earlier observer proposed that the sac seeks warm, moist surroundings. This is an interpretation, not a measured preference. The warm tool was also metal and made contact; humid air and liquid water were not equivalent in the observations.\n\nBefore choosing a configuration, separate attraction to a person from attraction to something the person carries. Compare electrical connection at the same material and temperature, then compare humidity without wetting the body. Avoid treating a reduction in one brief observation as proof of long-term containment. These notes leave the exact configuration open."

[sub_resource type="Resource" id="CCTV"]
script = ExtResource("cctv")
camera_id = "TEMP_M2_CAM_01"
observation_text = "SINGLE CAMERA / room 20 C, RH 35%, ordinary lighting, low airflow.\n\n00:00 — An operator passes with a rubbed polymer sleeve on a trolley. Fringe tips lean toward the sleeve, including after the operator steps away. The sac is not consistently oriented toward the person.\n\n00:40 — A warm, electrically isolated metal dummy is stationary at the same distance. It does not reproduce the sleeve-following movement. This comparison does not support warmth alone as the cause.\n\n01:20 — The operator clips the collection tray to a grounding lead. The body folds toward the tray and the broad extension stops. At this dry humidity the fine fringe still rises intermittently. Removing the clip precedes renewed extension; lighting and airflow stay unchanged.\n\nRoute context — The maintenance bypass has a grounded conductive floor and low airflow. The shorter supply passage has dry synthetic floor covering and a ventilation outlet. These are recorded route conditions, not a safety verdict."

[sub_resource type="Resource" id="Exp_GROUND"]
script = ExtResource("experiment")
experiment_id = "TEMP_M2_EXP_GROUND"
display_name = "Electrical connection comparison"
description = "Purpose: separate grounding from warmth and material. At 20 C and RH 35%, compare the same metal tray electrically isolated and connected to ground. Use no water and do not change the lamp or airflow. Observe broad extension and fine fringe separately."
result_text = "With the tray isolated, the membrane repeatedly extends toward a charged sleeve. Connecting the same tray to ground stops broad extension and folds the body back. Fine fringe still rises intermittently at RH 35%. Tray temperature does not change. Grounding explains much of the tool observation, but this dry configuration is not fully quiet."

[sub_resource type="Resource" id="Exp_HUMID"]
script = ExtResource("experiment")
experiment_id = "TEMP_M2_EXP_HUMID"
display_name = "Humidity without liquid contact"
description = "Purpose: test the residual response left by grounding. Keep the conductive tray grounded and the room at 20 C. Compare RH 35% and 63% with humid air only; the sac and tray stay free of droplets. Airflow and lighting remain unchanged."
result_text = "At RH 35%, the grounded body stays folded but fine fringe rises occasionally. At RH 63%, both broad extension and repeated fringe lifting cease during the observation. No membrane pieces detach. Returning to 35% restores fringe lifting. This supports moderate humid air together with grounding, not liquid feeding or heating."

[sub_resource type="Resource" id="Exp_WATER"]
script = ExtResource("experiment")
experiment_id = "TEMP_M2_EXP_WATER"
display_name = "Humid air versus direct wetting"
description = "Purpose: distinguish humidity control from the earlier liquid-water interpretation. On the grounded tray at RH 63% and 20 C, compare humid air alone with a small direct droplet applied through remote equipment. Capture any detached material; do not change the fan."
result_text = "Humid air alone keeps the body folded without shedding. Direct droplets loosen transparent pieces from the outer folds even though grounding and RH stay the same. Pieces remain separate when the bulk body contracts. More water is therefore not a stronger version of humid-air stabilization; direct wetting creates a transportable hazard."

[sub_resource type="Resource" id="Room_WARM"]
script = ExtResource("room")
room_id = "TEMP_M2_ROOM_WARM"
display_name = "Warm dry polymer enclosure"
description = "20 C baseline with a locally warm lamp; RH 30-35%; electrically isolated polymer liner; continuous fan circulation. No direct water. Intended to reproduce the earlier warm-tool interpretation."

[sub_resource type="Resource" id="Room_CONDUCTIVE"]
script = ExtResource("room")
room_id = "TEMP_M2_ROOM_CONDUCTIVE"
display_name = "Conductive humid-air enclosure"
description = "20 C; RH 60-65% without droplets; grounded conductive tray; ordinary lighting; low airflow with a membrane-capture screen at the outlet. The body is not immersed or directly sprayed."

[sub_resource type="Resource" id="Room_BATH"]
script = ExtResource("room")
room_id = "TEMP_M2_ROOM_BATH"
display_name = "Saturated immersion enclosure"
description = "20 C; RH 90-95%; shallow water over an electrically isolated acrylic base; still air and ordinary lighting. Intended to strengthen the earlier moisture interpretation by keeping the body wet."

[sub_resource type="Resource" id="Stage_WARM_0"]
script = ExtResource("stage")
time_offset = 0
observation_text = "Fine fringe rises over the dry insulating liner despite the warm lamp."

[sub_resource type="Resource" id="Stage_WARM_1"]
script = ExtResource("stage")
time_offset = 10
observation_text = "Repeated extension crosses the liner seam. Fan circulation carries detached material toward the outlet."

[sub_resource type="Resource" id="Stage_WARM_2"]
script = ExtResource("stage")
time_offset = 20
observation_text = "The submitted enclosure does not retain the membrane material. A later corridor report is required."

[sub_resource type="Resource" id="Outcome_WARM"]
script = ExtResource("outcome")
room_id = "TEMP_M2_ROOM_WARM"
stages = Array[ExtResource("stage")]([SubResource("Stage_WARM_0"), SubResource("Stage_WARM_1"), SubResource("Stage_WARM_2")])
final_result = 2
incident_id = "TEMP_M2_INCIDENT_ESCAPE"

[sub_resource type="Resource" id="Stage_CONDUCTIVE_0"]
script = ExtResource("stage")
time_offset = 0
observation_text = "The body stays folded on the grounded tray in moderately humid air."

[sub_resource type="Resource" id="Stage_CONDUCTIVE_1"]
script = ExtResource("stage")
time_offset = 10
observation_text = "No repeated fringe lifting or liquid-contact shedding is observed in this configuration."

[sub_resource type="Resource" id="Stage_CONDUCTIVE_2"]
script = ExtResource("stage")
time_offset = 20
observation_text = "The present configuration supports stable containment for the observation interval; no escape report is linked."

[sub_resource type="Resource" id="Outcome_CONDUCTIVE"]
script = ExtResource("outcome")
room_id = "TEMP_M2_ROOM_CONDUCTIVE"
stages = Array[ExtResource("stage")]([SubResource("Stage_CONDUCTIVE_0"), SubResource("Stage_CONDUCTIVE_1"), SubResource("Stage_CONDUCTIVE_2")])
final_result = 1
incident_id = ""

[sub_resource type="Resource" id="Stage_BATH_0"]
script = ExtResource("stage")
time_offset = 0
observation_text = "Direct water contact loosens pieces although the enclosure is very humid."

[sub_resource type="Resource" id="Stage_BATH_1"]
script = ExtResource("stage")
time_offset = 10
observation_text = "Separate pieces collect along the insulating rim and do not rejoin when the bulk body folds."

[sub_resource type="Resource" id="Stage_BATH_2"]
script = ExtResource("stage")
time_offset = 20
observation_text = "Material crosses the rim during access. Saturated immersion does not retain the specimen."

[sub_resource type="Resource" id="Outcome_BATH"]
script = ExtResource("outcome")
room_id = "TEMP_M2_ROOM_BATH"
stages = Array[ExtResource("stage")]([SubResource("Stage_BATH_0"), SubResource("Stage_BATH_1"), SubResource("Stage_BATH_2")])
final_result = 2
incident_id = "TEMP_M2_INCIDENT_ESCAPE"

[sub_resource type="Resource" id="Disturbance"]
script = ExtResource("disturbance")
disturbance_id = "TEMP_M2_DISTURBANCE_MEMBRANE"
display_name = "[TEMP / NON-CANON] Airborne membrane notice"
notice_text = "Thin detached material from the submitted specimen has been reported outside its enclosure. This is a later observation; the earlier submission is retained. Avoid the ventilation edge while the origin and route are checked."
condition_change_text = "Airborne-material caution is active in the facility. The notice does not claim that the specimen has been recovered or that casualties have occurred."

[sub_resource type="Resource" id="Incident"]
script = ExtResource("incident")
incident_id = "TEMP_M2_INCIDENT_ESCAPE"
display_name = "[TEMP / NON-CANON] Membrane escape into the access corridor"
description = "Detached membrane pieces have crossed the enclosure boundary and are visible in the access corridor. Fine fringes follow dry synthetic garments and polymer coverings. Pieces near the grounded conductive maintenance floor fold down; loose pieces at the supply-passage ventilation outlet are carried onward.\n\nThe low-airflow maintenance bypass and the shorter synthetic-lined supply passage remain available as marked routes. Staff need an evacuation instruction now. Recovery and casualties have not been confirmed. Use the recorded attraction and shedding evidence to choose how people should move and what they should avoid."
broadcast_id = "TEMP_M2_BROADCAST_EVAC"
environmental_disturbance = SubResource("Disturbance")

[sub_resource type="Resource" id="Result_BYPASS"]
script = ExtResource("result")
result_id = "TEMP_M2_RESULT_BYPASS"
display_name = "[TEMP / NON-CANON] Evacuation route exposure reduced"
description = "Reports after this instruction describe fewer pieces following the maintenance route. Ground contact and low airflow match the recorded behavior; avoiding direct wetting prevents the documented shedding action. This observation does not establish recapture or complete sealing, and does not undo the original enclosure failure."

[sub_resource type="Resource" id="Option_BYPASS"]
script = ExtResource("option")
option_id = "TEMP_M2_OPTION_BYPASS"
display_text = "Use the grounded, low-airflow maintenance bypass. Avoid synthetic-lined supply passages, ventilation outlets and loose pieces; do not wet or handle the membrane. Close the access door after passing and keep others out of the exposed corridor."
result_id = "TEMP_M2_RESULT_BYPASS"

[sub_resource type="Resource" id="Result_WARM_ROUTE"]
script = ExtResource("result")
result_id = "TEMP_M2_RESULT_WARM_ROUTE"
display_name = "[TEMP / NON-CANON] Synthetic route continues attracting pieces"
description = "Loose fringes continue following coverings along the synthetic-lined passage. The warm stationary comparison did not establish a heat preference, while the sleeve observation did establish a material-related response. Reports do not establish a safe passage or a casualty total."

[sub_resource type="Resource" id="Option_WARM_ROUTE"]
script = ExtResource("option")
option_id = "TEMP_M2_OPTION_WARM_ROUTE"
display_text = "Use the shorter warm-lit synthetic-lined passage. Keep moving close to its polymer wall and push obstructing pieces aside by hand."
result_id = "TEMP_M2_RESULT_WARM_ROUTE"

[sub_resource type="Resource" id="Result_WET_ROUTE"]
script = ExtResource("result")
result_id = "TEMP_M2_RESULT_WET_ROUTE"
display_name = "[TEMP / NON-CANON] Wetting adds detached material to the route"
description = "Direct contact with droplets precedes more detached pieces near the ventilation-side route. Humid air was not equivalent to direct wetting, and the earlier record showed an air pulse carrying pieces beyond a tray. The route remains under exposure caution; recapture has not been confirmed and no injury count has been established."

[sub_resource type="Resource" id="Option_WET_ROUTE"]
script = ExtResource("option")
option_id = "TEMP_M2_OPTION_WET_ROUTE"
display_text = "Wet garments and nearby membrane pieces while moving toward the ventilation-side exit; use the short route rather than the maintenance bypass."
result_id = "TEMP_M2_RESULT_WET_ROUTE"

[sub_resource type="Resource" id="Broadcast"]
script = ExtResource("broadcast")
broadcast_id = "TEMP_M2_BROADCAST_EVAC"
display_name = "[TEMP / NON-CANON] Staff evacuation instruction"
prompt_text = "Choose one staff evacuation instruction after the membrane escape. Use the Profile droplet record and the CCTV material/grounding observations. Choose the route and contact precautions from the observations already available. No civilian presence has been reported for this temporary incident."
options = Array[ExtResource("option")]([SubResource("Option_BYPASS"), SubResource("Option_WARM_ROUTE"), SubResource("Option_WET_ROUTE")])


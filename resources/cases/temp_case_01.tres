[sub_resource type="Resource" id="Resource_2mpr5"]
script = ExtResource("2_pq4oa")
experiment_id = "EXP_01_LIGHT"
display_name = "조명"
description = "[임시 실험 / 원격 절차]
실행 전 안내: 격리실 조명을 켜고 일정 시간 유지한 뒤 끈다. 소리와 온도는 바꾸지 않는다."
result_text = "[실행 기록 / TEMP]
조명이 켜지자 즉시 몸을 웅크리고 팔로 얼굴을 가렸다. 노출 후 손등이 붉어지고 물집이 올라왔다(영상 일부는 모자이크 처리). 조명을 끈 뒤 자세가 천천히 풀렸다."
result_texture = ExtResource("3_ktfhu")

[sub_resource type="Resource" id="Resource_4hdlr"]
script = ExtResource("2_pq4oa")
experiment_id = "EXP_01_SOUND"
display_name = "경보음"
description = "[임시 실험 / 원격 절차]
실행 전 안내: 경보음을 짧게 울린다. 조명과 온도는 바꾸지 않는다."
result_text = "[실행 기록 / TEMP]
고개를 한 번 돌렸을 뿐 자세와 피부에 큰 변화는 없었다. 경보음에 대한 반응은 제한적이었다."
result_texture = ExtResource("4_7i83f")

[sub_resource type="Resource" id="Resource_83a7k"]
script = ExtResource("2_pq4oa")
experiment_id = "EXP_01_TEMP"
display_name = "온도"
description = "[임시 실험 / 원격 절차]
실행 전 안내: 실온을 단계적으로 낮췄다가 복구한다. 조명과 소리는 바꾸지 않는다."
result_text = "[실행 기록 / TEMP]
약간 움츠러들었으나 자세와 피부에 변화는 없었다. 온도 변화 자체는 주요 불안정 요인으로 보이지 않는다."
result_texture = ExtResource("5_ixq2h")

[sub_resource type="Resource" id="Resource_2lk7f"]
script = ExtResource("8_qw408")
camera_id = "CAM_01_TEXT_OBSERVATION"
observation_text = "[TEMP / DRAFT / NON-CANON] 01 관찰 기록. 화면의 장면은 표준 격리실 이미지에 위치 표지만 얹은 임시 이미지이며 대상 사진이 아니다. 열화상은 미제공이다. 판단 근거는 아래 텍스트 관찰이다.

00:00 — 방 구석 그늘에 웅크린 채 정지. 천장 조명 아래로 나오지 않는다.
03:10 — 바닥의 밝은 구역을 돌아서 이동한다.
07:40 — 같은 자세. 손으로 눈 위를 가린다."
camera_label = "CAM 01-01 · 임시 격리실"
feed_texture = ExtResource("7_km5r7")


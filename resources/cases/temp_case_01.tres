title = "격리 환경 부적합: 피부 손상 누적"
body_text = "[TEMP / DRAFT / NON-CANON]
01의 피부 손상이 누적되어 상태가 악화되었다. 외부 소리를 차단했으나 일반 조도가 유지되었다. 탈출은 없다."

[sub_resource type="Resource" id="Resource_0o1qu"]

body_text = "[TEMP / DRAFT / NON-CANON]
01은 광원이 완전히 차단된 환경에서 안정 상태를 유지했다. 피부 반응은 더 진행되지 않았다. 감시는 적외선 카메라로 유지되었다."

[sub_resource type="Resource" id="Resource_l5jwt"]
